# Flask core secret key for signing session cookies
SECRET_KEY=
# Salt for password hashing
SECURITY_PASSWORD_SALT=
# Allow public account registration (true/false)
SECURITY_REGISTERABLE=true
# Database connection URL (e.g. postgresql+psycopg://user:pass@host:5432/dbname or sqlite:///app.db)
DATABASE_URL=
# Flask debug mode flag (true/false)
DEBUG=false
# Flask application environment (development/production)
FLASK_ENV=development
# Server listening port
PORT=5000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Google Gemini API key for GenAI features
GEMINI_API_KEY=
# Google Gemini text model name (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite
# Google Gemini embedding model name (default: gemini-embedding-001)
GEMINI_EMBED_MODEL=gemini-embedding-001
# Groq API key for LLM fallback
GROQ_API_KEY=
# Groq model name for LLM fallback (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b
# Enable background task scheduler (set false in test/CI environments)
ENABLE_SCHEDULER=true
# Enable public demo mode restrictions
DEMO_MODE=false
# Daily AI requests cap per user account in demo mode
AI_DAILY_LIMIT=20
# Global daily AI requests cap across all accounts
AI_GLOBAL_DAILY_LIMIT=300
# Secret header token to authorize external cron HTTP triggers
CRON_SECRET=
# Initial HR demo account email address
HR_EMAIL=hr@example.com
# Initial HR demo account password
HR_PASSWORD=hr123
# Initial HR demo account username
HR_USERNAME=hr
# Initial manager demo account email address
MANAGER_EMAIL=manager@example.com
# Initial manager demo account password
MANAGER_PASSWORD=manager123
# Initial manager demo account username
MANAGER_USERNAME=manager
# Initial employee demo account email address
EMPLOYEE_EMAIL=employee@example.com
# Initial employee demo account password
EMPLOYEE_PASSWORD=employee123
# Initial employee demo account username
EMPLOYEE_USERNAME=employee

